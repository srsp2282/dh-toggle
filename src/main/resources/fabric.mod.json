{
  "schemaVersion": 1,
  "id": "dhtoggle",
  "version": "${version}",
  "name": "DH Toggle",
  "description": "Adds a normal, remappable Fabric keybind for toggling Distant Horizons LOD rendering.",
  "authors": [
    "Jay"
  ],
  "contact": {
    "homepage": "https://github.com/srsp2282/dh-toggle",
    "sources": "https://github.com/srsp2282/dh-toggle",
    "issues": "https://github.com/srsp2282/dh-toggle/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.raptornet.dhtoggle.DhToggleClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "distanthorizons": "*"
  }
}
